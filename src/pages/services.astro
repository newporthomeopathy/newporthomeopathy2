---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { clinic, fees } from '../data/site';
import { serviceSchema } from '../data/schema';
---
<Base
  title="Homeopathy Services in Newport, Shropshire"
  description="In-person and online homeopathy consultations, follow-ups and a free 15-minute chat. Initial £50, follow-up £30. Newport, Shropshire and UK-wide."
  breadcrumbs={[{ name: 'Services', href: '/services/' }]}
  schema={[serviceSchema('in-person'), serviceSchema('online')]}
>
  <PageIntro
    h1="Homeopathy Services"
    lead={`Private, confidential one-to-one consultations with ${clinic.practitioner}, ${clinic.qualification}: in person in Newport or online across the UK. Initial £${fees.initial.price}, follow-up £${fees.followUp.price}.`}
  />
  <section style="padding-top:0">
    <div class="container">
      <ServiceCards detailed />
      <div class="text-col" style="margin-top:32px">
        <p>{clinic.hoursText}. Payment by {clinic.payment.toLowerCase()}. <a href="/what-to-expect/">What to expect</a> · <a href="/consultation-fees/">Fees</a> · <a href="/booking-terms/">Booking terms</a></p>
        <GpStatement />
      </div>
    </div>
  </section>
  <CtaBlock />
</Base>
