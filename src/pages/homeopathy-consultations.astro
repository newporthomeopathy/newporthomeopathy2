---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBlock from '../components/CtaBlock.astro';
import GpStatement from '../components/GpStatement.astro';
import MapFacade from '../components/MapFacade.astro';
import { clinic, fees, addressLine } from '../data/site';
import { serviceSchema } from '../data/schema';
---
<Base
  title="Homeopathy Consultations in Newport, Shropshire"
  description="One-to-one homeopathy consultations at 75 Forton Road, Newport TF10 8BU. Initial 30–90 minutes, £50. Monday to Saturday, 9am–6pm."
  breadcrumbs={[{ name: 'In-person consultations', href: '/homeopathy-consultations/' }]}
  schema={[serviceSchema('in-person')]}
>
  <PageIntro
    h1="Homeopathy Consultations at Our Newport Clinic"
    lead={`One-to-one homeopathy consultations with ${clinic.practitioner}, ${clinic.qualification}, at ${addressLine}. The initial consultation costs £${fees.initial.price} and lasts ${fees.initial.duration}; follow-ups cost £${fees.followUp.price}.`}
  />
  <section style="padding-top:0">
    <div class="container grid-2" style="align-items:start">
      <div class="prose">
        <h2>First consultation</h2>
        <p>Homeopathy is a system of complementary medicine developed over 200 years ago. Your first consultation ({fees.initial.duration}) is a detailed conversation about your health history, lifestyle and wellbeing. <a href="/what-to-expect/">What to expect</a></p>
        <h2>Follow-ups</h2>
        <p>Usually {fees.followUp.interval}, £{fees.followUp.price}, in person or <a href="/online-homeopathy-consultation/">online</a>.</p>
        <h2>Hours</h2>
        <p>{clinic.hoursText}. <a href="/consultation-fees/">Fees</a></p>
        <GpStatement />
      </div>
      <div>
        <h2>Finding the clinic</h2>
        <MapFacade />
        <p style="margin-top:12px"><a href="/areas-we-serve/">Areas we serve</a></p>
      </div>
    </div>
  </section>
  <CtaBlock />
</Base>
